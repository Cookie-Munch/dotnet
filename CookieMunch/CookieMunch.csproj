<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Types and public methods are documented; individual DTO properties are self-describing
         via their JSON names, so we don't require an XML comment on every property. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Packaging -->
    <IsPackable>true</IsPackable>
    <PackageId>CookieMunch</PackageId>
    <Version>0.1.0</Version>
    <Authors>Cookie Munch</Authors>
    <Description>Official .NET client for the Cookie Munch Developer API — a self-hosted Consent Management Platform. Covers the /v1 surface (sites, consent, DSAR, vendors, RoPA, brand kits, preferences, members, banners) plus the public consent-log ingest endpoint.</Description>
    <PackageTags>cookiemunch;consent;cmp;gdpr;privacy;cookies</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Cookie-Munch/dotnet</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" Condition="Exists('../README.md')" />
  </ItemGroup>

</Project>
